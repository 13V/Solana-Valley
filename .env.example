# Solana Valley — environment variables. Copy to .env (gitignored) for local
# scripts, and set the server ones in the Vercel project settings.
#
# ⚠️  SECRETS: SUPABASE_SERVICE_ROLE_KEY and TREASURY_SECRET_KEY bypass all
#     protections (RLS / treasury funds). Never commit them or expose them to the
#     browser. Only VITE_* vars are safe to ship to the client.

# ---- Client (Vite, build-time; safe to expose) --------------------------
# RPC the browser uses to read balances. Use a paid provider on mainnet.
VITE_SOLANA_RPC=
# Trustless merkle distributor program id (Option B). Unset = the on-chain
# self-claim widget stays hidden; set it after deploying programs/reward-distributor.
VITE_REWARD_DISTRIBUTOR_PROGRAM=
# The reward token's contract address shown in the copy pill. Set to your NEW
# token's mint; empty hides the pill. Defaults to the original $SPROUT mint.
VITE_TOKEN_CA=

# ---- Server: Supabase (cloud save + rewards API) ------------------------
# Service-role key bypasses RLS; used only by app/api/* serverless functions.
SUPABASE_SERVICE_ROLE_KEY=
# Optional — defaults to the project URL baked into app/api/_auth.ts.
SUPABASE_URL=

# ---- Server: reward payouts (app/api/claim.ts) --------------------------
# Required for the claim endpoint + the ops scripts to do anything; with these
# unset, /api/claim returns "not configured" and the claim widget stays hidden.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Your $LANDS mint address (from the pump.fun launch). On devnet, use the throwaway
# mint that scripts/rewards-setup.mjs create-mint prints.
REWARD_MINT=
# base58 64-byte secret key of the treasury wallet (signs payouts + buybacks).
# Tip: launch $LANDS on pump.fun FROM this wallet so creator fees accrue here.
TREASURY_SECRET_KEY=
# Token display/units. pump.fun tokens are 6 decimals.
REWARD_DECIMALS=6
REWARD_SYMBOL=$LANDS
# $LANDS price in USD, used to convert the per-tier trade values (Divine $2.50 /
# Prismatic $5 / Celestial $10) into a token amount. SET THIS at launch — a fresh
# pump.fun token may not be on price aggregators yet. If unset, the redeem API
# falls back to Jupiter's price API; if that has no price, trades are disabled.
LANDS_USD_PRICE=
# Optional: override Jupiter's price endpoint (default https://lite-api.jup.ag/price/v2).
JUPITER_PRICE_API=

# ---- Ops scripts only ---------------------------------------------------
# Jupiter swap API base, used by scripts/buyback.mjs.
JUPITER_API=https://quote-api.jup.ag/v6
